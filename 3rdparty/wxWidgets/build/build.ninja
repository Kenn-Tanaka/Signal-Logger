  DESC = Install the project...
  pool = console
  restat = 1

build libs/base/install: phony libs/base/CMakeFiles/install.util


#############################################
# Utility command for install/local

build libs/base/CMakeFiles/install/local.util: CUSTOM_COMMAND libs/base/all
