build utils/CMakeFiles/install/strip.util: CUSTOM_COMMAND utils/all
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D X:\3rdparty\wxWidgets\build\utils && C:\Strawberry\c\bin\cmake.exe -DCMAKE_INSTALL_DO_STRIP=1 -P cmake_install.cmake"
  DESC = Installing the project stripped...
  pool = console
  restat = 1

build utils/install/strip: phony utils/CMakeFiles/install/strip.util

