{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 26,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release (Ninja / MinGW UCRT)",
      "description": "Optimized release build using Ninja and static linking",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "displayName": "Build Release",
      "configurePreset": "release"
    }
  ],
  "testPresets": [
    {
      "name": "test-all",
      "displayName": "Run All Tests",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-smoke",
      "displayName": "Run Smoke Test",
      "configurePreset": "release",
      "filter": {
        "include": {
          "name": "TestSmokeTest"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
